# ============================================================
#  Leitstand — Einstellungen für den Stack
#
#  Diese Datei liegt neben docker-compose.yml und wird beim Einsetzen
#  automatisch gelesen. In Portainer lassen sich dieselben Werte auch
#  im Formular unter "Environment variables" setzen; was dort steht,
#  gewinnt gegenüber dieser Datei.
#
#  HIER GEHÖREN KEINE ZUGANGSDATEN HINEIN.
#  API-Token für Proxmox & Co. werden in der Oberfläche unter
#  Verwaltung hinterlegt und landen in secrets.json im Volume —
#  mit Rechten 0600 und niemals im Klartext nach außen.
# ============================================================

# ---- Abbild -------------------------------------------------
# :main folgt dem Hauptzweig, :latest ist gleichbedeutend.
# Für einen festen Stand einen sha-Tag eintragen, z. B. :sha-e07662a
LEITSTAND_IMAGE=ghcr.io/dukynuky/leitstand:main

# ---- Erreichbarkeit ----------------------------------------
# Port auf dem Docker-Wirt. Im Container bleibt es 8080.
LEITSTAND_PORT=8080

# Nur an eine bestimmte Adresse binden? Dann etwa 127.0.0.1 eintragen
# und den Zugriff über den Reverse Proxy führen. Leer = alle Adressen.
LEITSTAND_BIND=

# ---- Ablage -------------------------------------------------
# Standard ist ein benanntes Volume. Für einen festen Pfad auf dem Wirt
# stattdessen ein Verzeichnis eintragen, z. B. /srv/leitstand/data —
# dann liegen inventory.yaml, secrets.json und incidents.json dort und
# lassen sich auch von Hand sichern.
LEITSTAND_DATA=leitstand-data

# ---- Umgebung -----------------------------------------------
TZ=Europe/Berlin

# Neustartverhalten: unless-stopped, always, on-failure oder no
LEITSTAND_RESTART=unless-stopped

# ============================================================
#  Nicht hier einstellbar — und warum
#
#  Abfrageintervall, Zeitlimits, Schwellwerte für Speicher, Zertifikate
#  und Handshakes stehen in inventory.yaml und werden in der Oberfläche
#  unter Verwaltung -> Schwellwerte gepflegt. Zwei Quellen für denselben
#  Wert wären der sichere Weg in Verwirrung: eine Änderung in der
#  Oberfläche sähe dann folgenlos aus, weil die Umgebung sie überschreibt.
# ============================================================
